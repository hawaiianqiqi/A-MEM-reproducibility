# Copy to .env and fill in. .env is git-ignored — never commit a real key.
# The harness reads these through memory_layer_robust (backend="deepseek").
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: cost accounting assumptions used by instrument.py (USD per 1M tokens).
# Check https://api-docs.deepseek.com/quick_start/pricing before quoting costs.
PRICE_IN_PER_MTOK=0.28
PRICE_OUT_PER_MTOK=0.42

# This machine cannot reach huggingface.co directly; the mirror serves the same weights.
HF_ENDPOINT=https://hf-mirror.com
# bert_f1 is not part of the reported comparison, so a small model keeps the run cheap.
BERTSCORE_MODEL=distilbert-base-uncased
